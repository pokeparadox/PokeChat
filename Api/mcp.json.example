{
  "mcpServers": {
    "docs-search": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-docs-search"],
      "enabled": false
    },
    "mempalace": {
      "transport": "stdio",
      "command": "mempalace-mcp",
      "args": [],
      "enabled": true,
      "toolTriggers": [
        {
          "pattern": "(search|ask|check) (your )?(memory|memories|palace) for (.+)",
          "inputType": "Statement",
          "responses": [
            "Let me search my memories for that. {tool:mempalace_search:{$4}}",
            "I'll check what I remember about that. {tool:mempalace_search:{$4}}"
          ]
        },
        {
          "pattern": "what do you (remember|know) about (.+)",
          "inputType": "Question",
          "responses": [
            "Let me check my memories about that. {tool:mempalace_search:{$2}}"
          ]
        }
      ]
    }
  }
}
